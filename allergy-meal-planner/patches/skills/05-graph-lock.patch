   lint [dir]           Validate SKILL.md frontmatter in a directory (default: skills)
   validate             Validate skill dep graph (scheme, file: existence, cycles)
   init [name]          Initialize a skill (creates <name>/SKILL.md or ./SKILL.md)
@@ -8606,6 +8892,12 @@ async function main() {
 		case "check-skill":
 			await runLint(restArgs);
 			break;
+		case "lock":
+			await runLock(restArgs);
+			break;
+		case "verify":
+			await runVerify(restArgs);
+			break;
 		case "list":
 		case "ls":
 			await runList(restArgs);
