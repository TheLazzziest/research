+async function runLint(args = []) {
+	const target = args[0] ?? "skills";
+	const root = resolve(target);
+	if (!existsSync(root)) {
+		console.log(`${import_picocolors.default.red("✗")} Lint root not found: ${root}`);
+		process.exitCode = 1;
+		return;
+	}
+	let entries;
+	try {
+		entries = readdirSync(root, { withFileTypes: true });
+	} catch (err) {
+		console.log(`${import_picocolors.default.red("✗")} Cannot read ${root}: ${err.message}`);
+		process.exitCode = 1;
+		return;
+	}
+	let checked = 0, passed = 0, failed = 0;
+	for (const entry of entries) {
+		if (!entry.isDirectory()) continue;
+		const skillDir = join(root, entry.name);
+		const skillMd = join(skillDir, "SKILL.md");
+		if (!existsSync(skillMd)) continue;
+		checked++;
+		const ok = await isValidSkillMarkdown(skillMd);
+		if (ok) {
+			passed++;
+			console.log(`${import_picocolors.default.green("✓")} ${entry.name}`);
+		} else {
+			failed++;
+			console.log(`${import_picocolors.default.red("✗")} ${entry.name} (invalid frontmatter)`);
+		}
+	}
+	if (checked === 0) {
+		console.log(`${import_picocolors.default.dim("No skills found")} in ${root}`);
+		return;
+	}
+	console.log(`\n${checked} skill(s): ${import_picocolors.default.green(String(passed))} ok, ${failed > 0 ? import_picocolors.default.red(String(failed)) : String(failed)} invalid`);
+	if (failed > 0) process.exitCode = 1;
+}
