+// --- P2: linking local skills into the canonical agent store, as part of add/sync ---
+// Symlink each local skill from `skills/` into the canonical agent skills dir, so
+// agents refer to one place while `skills/` stays the source of truth. Best-effort:
+// never fails the caller.
+function skillsDirFromArgs(args) {
+	const i = Array.isArray(args) ? args.indexOf("--skills-dir") : -1;
+	return i >= 0 && args[i + 1] ? args[i + 1] : "skills";
+}
+async function linkLocalSkills(skillsDir = "skills", target = join(".agents", "skills")) {
+	try {
+		const root = resolve(skillsDir);
+		if (!existsSync(root)) return;
+		const targetDir = resolve(target);
+		await mkdir(targetDir, { recursive: true });
+		const names = readdirSync(root, { withFileTypes: true })
+			.filter((e) => e.isDirectory() && existsSync(join(root, e.name, "SKILL.md")))
+			.map((e) => e.name);
+		let linked = 0;
+		for (const name of names) {
+			const linkPath = join(targetDir, name);
+			try {
+				const st = await lstat(linkPath);
+				if (st.isSymbolicLink()) await rm(linkPath);
+				else if (st.isDirectory()) continue;
+			} catch {}
+			await symlink(relative(targetDir, join(root, name)), linkPath, "dir");
+			linked++;
+		}
+		if (linked > 0) console.log(`${import_picocolors.default.green("✓")} linked ${linked} local skill(s) into ${relative(process.cwd(), targetDir)}`);
+	} catch {}
+}
 async function removeCommand(skillNames, options) {
 	const agentResult = await detectAgent();
 	if (agentResult.isAgent) {
