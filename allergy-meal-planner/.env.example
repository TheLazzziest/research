# Backboard adapter: routes the task to open-weight models on a hosted provider.
# Key from app.backboard.io. Providers with open weights: cerebras, openrouter, featherless.
BACKBOARD_API_KEY=your-key-here
LLM_PROVIDER=cerebras
BACKBOARD_MODEL=openai/gpt-oss-120b

# Backboard memory mode: Auto | Readonly | off
BACKBOARD_MEMORY=Auto

# System One (Jev) gatekeeper: off | each | gate
#   off  - never classify (cheapest)
#   each - classify every client message (interview facts)
#   gate - classify only acting turns, as an output safety/quality gate (default)
CLASSIFY=gate

PORT=8787
