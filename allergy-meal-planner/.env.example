# Backboard adapter: routes the task to open-weight models on a hosted provider.
# Key from app.backboard.io. Providers with open weights: cerebras, openrouter, featherless.
BACKBOARD_API_KEY=your-key-here
LLM_PROVIDER=cerebras
BACKBOARD_MODEL=openai/gpt-oss-120b

# Optional model preset (overrides provider/model): gemma | qwen | llama | gptoss
# MODEL_PRESET=gemma        # -> openrouter / google/gemma-3-27b-it

# Backboard memory mode: Auto | Readonly | off
BACKBOARD_MEMORY=Auto

# System One (Jev) gatekeeper: off | each | gate  (default: gate = acting turns only)
CLASSIFY=gate

# Spoken-summary step after the gate passes: on | off (default: on)
#   on  - add a short summary for narration; the full report still goes to the UI
#   off - narrate the full report text
SUMMARIZE=on

# Sentry agent tracing (optional). Traces model calls with latency + usage.
SENTRY_DSN=

# ElevenLabs voice narration (optional). POST /api/tts returns audio/mpeg.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

PORT=8787
